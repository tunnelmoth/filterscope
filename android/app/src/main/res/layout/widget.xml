<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp">
    <TextView android:id="@+id/score" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="—" android:textSize="34sp" android:textStyle="bold" android:textColor="#C4B5FD" android:minWidth="64dp" android:gravity="center"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="filterscope" android:textStyle="bold" android:textSize="14sp" android:textColor="#EEF2F7"/>
        <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="tap to scan" android:textSize="12sp" android:textColor="#A3ADBD" android:maxLines="2"/>
    </LinearLayout>
</LinearLayout>
